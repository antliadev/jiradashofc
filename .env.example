# JiraDash official environment example.
# Copy to .env locally or configure as Vercel/GitHub/Supabase secrets.
# Never commit real secrets, tokens, cookies, sessions or service-role keys.

# Jira integration - backend only
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-service-account@antlia.com.br
JIRA_API_TOKEN=replace_with_jira_api_token
JIRA_JQL=project is not EMPTY ORDER BY updated DESC
JIRA_EXTRA_FIELDS=
JIRA_BLOCK_REASON_FIELD=
JIRA_BLOCK_ACTION_FIELD=
JIRA_BLOCK_PENDING_FIELD=

# Supabase Auth and official project
AUTH_PROVIDER=supabase
AUTH_REQUIRE_EMAIL_CONFIRMATION=true
AUTH_ALLOWED_DOMAIN=antlia.com.br
AUTH_ADMIN_EXCEPTION_EMAILS=admin@example.com
AUTH_REQUIRE_API_AUTH=true
AUTH_SITE_URL=https://radarjira.antlia.com.br

SUPABASE_URL=https://vzkiniwjhnhfximpfzuk.supabase.co
SUPABASE_ANON_KEY=replace_with_publishable_or_anon_key

# Backend privileged key - never expose to browser
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# or, when using modern Supabase secret keys:
SUPABASE_SECRET_KEY=

# Sprint Review: servidor somente. Nunca usar prefixo VITE_ para esta chave.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Backend secrets
# Preencha localmente/na Vercel. Nao versionar valores reais.
JIRA_ENCRYPTION_KEY=
AUTH_SESSION_SECRET=
CRON_SECRET=

# Temporary legacy auth fallback only when AUTH_PROVIDER=legacy.
AUTH_EMAIL=
AUTH_PASSWORD=

# Business configuration
DOCWISE_TOTAL_CAPACITY_HOURS=1440
PORT=3001
